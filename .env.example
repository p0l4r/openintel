JWT_SECRET=change-me
IP_HASH_SALT=change-me-too
# Set true ONLY behind a reverse proxy you control (otherwise X-Forwarded-For can be spoofed)
TRUST_PROXY_HEADERS=false

# Local Ollama, sized for a 4 GB GPU (GTX 1650). Pull it with:
#   docker compose exec ollama ollama pull qwen2.5:3b
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# Paid alternative: LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o-mini

# Slower local model => give jobs more time and fewer pages
JOB_TIMEOUT_S=1200
MAX_PAGES=8
# More chunks = more relationships found, but one model call each (~10-20 s on a GTX 1650)
MAX_CHUNKS=24

# Web search. Out of the box the app tries DuckDuckGo (no key) and then SearXNG.
# For reliable Google/Brave-quality results add ONE of these keys (both optional):
BRAVE_API_KEY=
SERPER_API_KEY=

# Search quotas per rolling 30 days. 0 = unlimited (fine for a private instance).
# For a public instance, e.g. GUEST_LIMIT=10 (per IP) and USER_LIMIT=100 (per account).
GUEST_LIMIT=0
USER_LIMIT=0
FRONTEND_URL=http://localhost:5173
